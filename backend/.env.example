# Copy this file to .env and fill in your keys.
# LiteLLM reads these automatically from the environment.

OPENAI_API_KEY=sk-your-openai-key
GEMINI_API_KEY=your-gemini-key

# Optional: override the default router models
PRIMARY_LLM_MODEL=gpt-4o
FALLBACK_LLM_MODEL=gemini/gemini-1.5-pro

# Optional: default workspace for Smart Ledger rollback (relative file paths)
ARCHITEX_WORKSPACE=/absolute/path/to/your/repo
